NODE_ENV=development
PORT=3000

# Local dev (docker-compose postgres) — ignored if DATABASE_URL is set (Render/production).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=transfer_system
DB_PASSWORD=transfer_system
DB_NAME=transfer_system

# Production (Render): a single connection string, takes priority over DB_* above.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173

# Shared secret for the external cron pinger — see /internal/sweep and the Render
# deployment README section. Required in production; leave unset locally.
# SWEEP_SECRET=
